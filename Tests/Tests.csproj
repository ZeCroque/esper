<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="nunit" Version="3.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.15.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\esper\esper.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <TestFixtures Include="$(MSBuildThisFileDirectory)..\fixtures\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\definitions.zip" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="@(TestFixtures)" DestinationFiles="@(TestFixtures->'$(TargetDir)fixtures\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
